# Виртуальные окружения и кэш
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.benchmarks/
.ruff_cache/
.mypy_cache/
*.egg-info/

# Секреты — никогда не коммитим (см. reqs.md: "Секреты и ключи не лежат в репозитории")
.env
.env.*
!.env.example

# Артефакты работы агента (воспроизводимы, но не часть поставки)
state/
journal/
logs/
!state/.gitkeep
!journal/.gitkeep

# Отчёты замеров и база MLflow: накапливаются по ходу работы
reports/bench/
mlruns/
mlruns.db

# Свип модели и окна: решение и накопитель коммитятся (по ним видно, что
# измерялось), а результаты клеток — промежуточные, их заменяет свежий замер.
reports/role_sweep/results/

# Отчёты по сессиям (reports/sessions/) коммитятся: по ним видно, что
# именно измерялось, и их можно проверить. Сырые прогоны бенчмарка —
# нет: они весят и заменяются свежими.

# Хранилище знаний (knowledge/) коммитится намеренно: сырые выгрузки
# открытых данных малы, а по манифесту жюри может проверить, на каких
# данных опирался вывод.
#
# Исключение — очередь распознания незнакомых слов: это след работы,
# который накапливается между запусками и не является частью поставки.
knowledge/lexicon/oov.jsonl
# Кэш переводов: это след работы модели, а не часть поставки. Он ключуется
# хешем исходного текста, поэтому его всегда можно пересчитать заново.
knowledge/translations/

# Прочее
.DS_Store
*.log
