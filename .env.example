# ─────────────────────────────────────────────────────────────────────────────
# Конфигурация агента. Скопируйте в .env и заполните при необходимости.
# В репозитории лежат только .env.example — реальные значения не коммитятся.
#
# РЕЖИМ ПО УМОЛЧАНИЮ: локальная модель через Ollama.
# Ничего заполнять не нужно, если Ollama запущен на localhost:11434.
# ─────────────────────────────────────────────────────────────────────────────

# ── LLM: провайдер ──────────────────────────────────────────────────────────
# "ollama" (по умолчанию, бесплатно, без секретов) | "openai" (нужен ключ)
PF_LLM_PROVIDER=ollama

# Ollama
PF_OLLAMA_BASE_URL=http://localhost:11434
# Модель по умолчанию. Измерено на демонстрационной задаче:
#   qwen2.5:7b   (4.7 ГБ) — 0-2 подтверждённых основания, ~100 с
#   qwen3:8b     (5.2 ГБ) — до 5 подтверждённых оснований, ~200 с
# Рекомендуется qwen3:8b: качество выше, цена — время.
# Скачать заранее:  ollama pull qwen3:8b
PF_OLLAMA_MODEL=qwen3:8b

# Thinking-режим (reasoning-модели qwen3, deepseek-r1).
# Выключен: агент разбирает строгий JSON, а рассуждение вместо JSON
# ломает разбор. Включайте, только если проверили на своей модели.
PF_OLLAMA_THINK=false

# OpenAI-совместимый (нужен только если PF_LLM_PROVIDER=openai).
# Подойдёт DeepSeek: https://api.deepseek.com, модель deepseek-flash.
PF_LLM_BASE_URL=
PF_LLM_API_KEY=
PF_LLM_MODEL=

# ── Параметры генерации ─────────────────────────────────────────────────────
PF_TEMPERATURE=0.2
PF_MAX_TOKENS=2400
PF_TIMEOUT_SECONDS=180

# ── Источники ───────────────────────────────────────────────────────────────
# Локальный корпус Википедии (см. data/wiki/SOURCE.md)
PF_WIKI_DIR=data/wiki
# Сколько статей взять в срез по запросу
PF_SOURCE_TOP_K=6
# Сколько абзацев из статьи уходит в контекст
PF_SOURCE_MAX_PARAGRAPHS=6

# ── Источники в интернете ──────────────────────────────────────────────────
# Внешние источники никогда не становятся подтверждёнными основаниями:
# их статус — «требует проверки». По умолчанию выключено, чтобы демо
# не зависело от сети.
PF_ENABLE_WEB=false

# Сколько результатов искать и сколько страниц разбирать за раз.
PF_WEB_SEARCH_LIMIT=5
PF_WEB_FETCH_LIMIT=3

# Куда искать MCP-серверы (соседний репозиторий mcp-servers).
PF_MCP_DIR=../mcp-servers

# ── Трекинг замеров ───────────────────────────────────────────────────────
# MLflow нужен для накопления измерений (сравнение с обычным чатом).
# Если пакет не установлен, трекинг молча выключается — работа агента
# не ломается. MLFLOW_DISABLED=1 — выключить принудительно.
# MLFLOW_TRACKING_URI=file:./mlruns
# MLFLOW_DISABLED=0
