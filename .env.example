# ─────────────────────────────────────────────────────────────────────────────
# Конфигурация агента. Скопируйте в .env и заполните при необходимости.
# В репозитории лежат только .env.example — реальные значения не коммитятся.
#
# РЕЖИМ ПО УМОЛЧАНИЮ: локальная модель через Ollama.
# Ничего заполнять не нужно, если Ollama запущен на localhost:11434.
# ─────────────────────────────────────────────────────────────────────────────

# ── LLM: провайдер ──────────────────────────────────────────────────────────
# "ollama" (по умолчанию, бесплатно, без секретов) | "openai" (нужен ключ)
PF_LLM_PROVIDER=ollama

# Ollama
PF_OLLAMA_BASE_URL=http://localhost:11434
# Модель по умолчанию. Измерено на демонстрационной задаче:
#   qwen2.5:7b   (4.7 ГБ) — 0-2 подтверждённых основания, ~100 с
#   qwen3:8b     (5.2 ГБ) — в среднем 3,3 подтверждённых основания, ~130 с
# По умолчанию qwen3:8b: качество выше, цена — время.
# Скачать заранее:  ollama pull qwen3:8b
PF_OLLAMA_MODEL=qwen3:8b

# Thinking-режим (reasoning-модели qwen3, deepseek-r1).
# Выключен: агент разбирает строгий JSON, а рассуждение вместо JSON
# ломает разбор. Включайте, только если проверили на своей модели.
PF_OLLAMA_THINK=false

# Окно контекста локальной модели. Ollama по умолчанию берёт 4096 и
# ОБРЕЗАЕТ промпт: на сохранённых журналах 56 шагов упирались ровно в
# 4096 токенов, и начало контекста отбрасывалось молча.
# 12288 — по замеру (docs/decisions.md, D-20): при 8192 промпты analyst
# (9433) и strategy (9560) не влезали; при 12288 не упирается ни один шаг
# из девяти, видеопамяти занято 6,7 ГБ из 8,1 ГБ, прогон дольше на ~22 %.
# На карте меньше 8 ГБ верните 8192. Окно обязано быть больше
# PF_MAX_TOKENS — иначе настройки не создадутся.
PF_OLLAMA_NUM_CTX=12288

# OpenAI-совместимый (нужен только если PF_LLM_PROVIDER=openai).
# Подойдёт DeepSeek: https://api.deepseek.com, модель deepseek-flash.
PF_LLM_BASE_URL=
PF_LLM_API_KEY=
PF_LLM_MODEL=

# ── Параметры генерации ─────────────────────────────────────────────────────
PF_TEMPERATURE=0.2
# Лимит ответа. 2400 токенов не хватало: JSON стратегии обрывался на
# середине, и шаг терялся целиком — поэтому 3200. Окно контекста обязано
# быть больше лимита, иначе настройки не создадутся.
PF_MAX_TOKENS=3200
PF_TIMEOUT_SECONDS=180

# Просить модель уложиться в лимит ответа. Лимит уже режет генерацию, но
# модель об этом не знает и присылает обрезанный JSON.
PF_ANSWER_LIMIT_HINT=true
# Сколько символов ограничений задачи попадает в запрос. Длинный блок
# вытесняет схему ответа.
PF_MAX_CONSTRAINTS_CHARS=600

# ── Проверка оснований ──────────────────────────────────────────────────────
# Допуск для чисел: «77,3» подтверждает «77,26» — это округление, а не
# подмена. Абсолютный допуск действует только для величин от единицы:
# для 0,2 допуск 0,1 — это половина значения.
PF_METRIC_ABS_TOLERANCE=0.1
PF_METRIC_REL_TOLERANCE=0.0005
# Порог покрытия утверждения словами абзаца (по леммам и синонимам).
# Это признак, а не решение: решение принимает степень поддержки полями
# (понятия, субъект, период, величины, термины) — см. PF_CLAIM_SUPPORT_THRESHOLD.
PF_CLAIM_MIN_OVERLAP=0.8
# Порог степени поддержки утверждения полями: ниже него утверждение не
# подтверждается. Значение заморожено по замеру на 60 размеченных парах
# (`eval/pairs/out_of_place.jsonl`); подбирается `make tune-threshold`.
PF_CLAIM_SUPPORT_THRESHOLD=0.17
# Сколько подтверждённых оснований считается достаточным. Меньше — хук
# расширяет план сбора источников.
PF_MIN_CONFIRMED_CITATIONS=2
# Предел расхода одной сессии в условных единицах (1 единица = 1 000 000
# токенов). Ноль — без предела.
PF_MAX_COST_UNITS=0

# ── Домен проекта: субъекты и термины ───────────────────────────────────────
# Словарь домена (entities.yaml) коммитится: это данные задачи, а не след
# работы. Второй проект задаёт свой каталог — код при этом не правится.
PF_DOMAIN_DIR=knowledge/domain

# ── Лексикон: словарь близости и очередь распознания ────────────────────────
# Словарь (synonyms.yaml) коммитится, очередь (oov.jsonl) — нет.
PF_LEXICON_DIR=knowledge/lexicon
# Накопление незнакомых слов. Выключение полезно для чистых замеров.
PF_LEXICON_ENABLED=true
# Сколько незнакомых слов разбирать за один вызов модели.
PF_LEXICON_ENRICH_LIMIT=50
# Допустимое расстояние Дамерау—Левенштейна для «похоже на опечатку».
PF_TYPO_MAX_DISTANCE=1
# С какой длины слово становится кандидатом в опечатку и сколько примеров
# контекста хранить на слово в очереди распознания.
PF_OOV_MIN_LENGTH=4
PF_OOV_MAX_CONTEXTS=3

# ── Перевод внешних материалов ──────────────────────────────────────────────
# Английский источник без перевода почти бесполезен: проверка оснований
# сверяет в нём только числа. Перевод даёт русский текст, в котором цитату
# можно искать дословно, а числа по-прежнему сверяются с оригиналом.
# Кэш обязателен: перевод недетерминирован, а прогон должен повторяться.
PF_TRANSLATIONS_DIR=knowledge/translations
# Предел длины куска при переводе: длинный кусок модель пересказывает.
PF_TRANSLATE_MAX_CHARS=1200

# ── Источники ───────────────────────────────────────────────────────────────
# Локальный корпус Википедии (см. data/wiki/SOURCE.md)
PF_WIKI_DIR=data/wiki
# Сколько статей взять в срез по запросу
PF_SOURCE_TOP_K=6
# Сколько абзацев из статьи уходит в контекст
PF_SOURCE_MAX_PARAGRAPHS=6

# Сырые выгрузки (knowledge/raw/<дата>/) читаются как материалы: агент видит
# скачанные открытые данные. Цитата из выгрузки проверяется дословно, но
# происхождение не проверено — поэтому основание не поднимается выше
# «требует проверки», как у внешнего источника.
PF_INCLUDE_KNOWLEDGE_RAW=true

# ── Источники в интернете ──────────────────────────────────────────────────
# Внешние источники никогда не становятся подтверждёнными основаниями:
# их статус — «требует проверки». По умолчанию выключено, чтобы демо
# не зависело от сети.
PF_ENABLE_WEB=false

# Сколько результатов искать и сколько страниц разбирать за раз.
PF_WEB_SEARCH_LIMIT=5
PF_WEB_FETCH_LIMIT=3
# Сколько подтверждённых оснований достаточно, чтобы не идти в веб.
PF_WEB_MIN_CITATIONS=2

# Куда искать MCP-серверы (соседний репозиторий mcp-servers).
PF_MCP_DIR=../mcp-servers

# ── Трекинг замеров ───────────────────────────────────────────────────────
# MLflow нужен для накопления измерений (сравнение с обычным чатом).
# Если пакет не установлен, трекинг молча выключается — работа агента
# не ломается. MLFLOW_DISABLED=1 — выключить принудительно.
# MLFLOW_TRACKING_URI=file:./mlruns
# MLFLOW_DISABLED=0
