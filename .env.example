# ─────────────────────────────────────────────────────────────────────────────
# Конфигурация агента. Скопируйте в .env и заполните при необходимости.
# В репозитории лежат только .env.example — реальные значения не коммитятся.
#
# РЕЖИМ ПО УМОЛЧАНИЮ: локальная модель через Ollama.
# Ничего заполнять не нужно, если Ollama запущен на localhost:11434.
# ─────────────────────────────────────────────────────────────────────────────

# ── LLM: провайдер ──────────────────────────────────────────────────────────
# "ollama" (по умолчанию, бесплатно, без секретов) | "openai" (нужен ключ)
PF_LLM_PROVIDER=ollama

# Ollama
PF_OLLAMA_BASE_URL=http://localhost:11434
# Модель 7B (4.7 ГБ) даёт качественный разбор и, главное, приводит
# ДОСЛОВНЫЕ цитаты — только они проходят строгую проверку оснований.
# Скачать заранее:  ollama pull qwen2.5:7b
# Если места мало, поставьте qwen2.5:3b (1.9 ГБ): работать будет,
# но цитат модель не приводит — основания проверяются по покрытию абзацем.
PF_OLLAMA_MODEL=qwen2.5:7b

# OpenAI-совместимый (нужен только если PF_LLM_PROVIDER=openai)
PF_LLM_BASE_URL=
PF_LLM_API_KEY=
PF_LLM_MODEL=

# ── Параметры генерации ─────────────────────────────────────────────────────
PF_TEMPERATURE=0.2
PF_MAX_TOKENS=1200
PF_TIMEOUT_SECONDS=180

# ── Источники ───────────────────────────────────────────────────────────────
# Локальный корпус Википедии (см. data/wiki/SOURCE.md)
PF_WIKI_DIR=data/wiki
# Сколько статей взять в срез по запросу
PF_SOURCE_TOP_K=6
# Сколько абзацев из статьи уходит в контекст
PF_SOURCE_MAX_PARAGRAPHS=6
